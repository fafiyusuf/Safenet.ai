# SafeNet.ai Backend Express Configuration
PORT=8000
NODE_ENV=development

# Neon PostgreSQL / Supabase / Local PostgreSQL URL
# e.g. postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Groq API Key (Primary AI provider - get from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key (Fallback AI provider - get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# JWT Secret for Admin Authentication (generate 64 chars in production)
JWT_SECRET=safenet-dev-jwt-secret-key-12345

# Allowed CORS origin
CORS_ORIGIN=http://localhost:3000

# Optional: Disable SSL for local postgres testing (true/false)
DB_SSL=true
